# Production server: use compose.yaml alone (no api port; compose.override.yaml is dev-only)
# COMPOSE_FILE=compose.yaml

# Reverse proxy on the host forwards to this.
FRONTEND_PORT=5173
# Dev only (compose.override.yaml), for the Vite /api proxy.
API_PORT=5183

# Postgres
DB_NAME=site
DB_USER=site
DB_PASSWORD=change-me

# API
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGINS=http://localhost:5173
# JWT signing key, required: openssl rand -base64 48
API_JWT_KEY=
# Per-IP limits (requests per minute)
RATE_LIMIT_PERMIT=10
RATE_LIMIT_GENERAL_PERMIT=120
RATE_LIMIT_PAGES_PERMIT=600
# Proxies allowed to set X-Forwarded-For (CIDRs, comma-separated)
FORWARDED_KNOWN_NETWORKS=172.16.0.0/12
# Set to false only when serving over plain HTTP on a host other than localhost.
AUTH_SECURE_COOKIE=true
# First admin account, created on startup (password >= 12 chars); clear afterwards.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
# Email / SMTP (empty SMTP_HOST: links are logged by the API instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Website
# Public origin (email links, canonical / link-preview URLs), no trailing slash
APP_BASE_URL=http://localhost:${FRONTEND_PORT}

# Media storage (SeaweedFS S3, internal to the compose network), required: openssl rand -hex 32
S3_ACCESS_KEY=cms
S3_SECRET_KEY=
S3_BUCKET=media

# Full backups (admin: Profile → Backups, super admins): host folder bind-mounted at /backups in the api.
# Empty = ./backups. The backups-init service hands it to the api's user (uid 1654) on every start.
BACKUP_DIR=

# Vite dev server only: target of the /api proxy
VITE_API_BASE_URL=http://127.0.0.1:${API_PORT}
